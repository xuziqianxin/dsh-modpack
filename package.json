{
  "name": "dsh-modpack",
  "version": "0.1.1",
  "type": "module",
  "description": "Modpack-style plugin groups for DeepSeek Harness: an always-on whitelist plus switchable modpacks that enable their plugins and close everything else.",
  "icon": "icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "modpack"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  }
}
